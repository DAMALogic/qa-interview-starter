{
  "name": "qa-interview-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client && npm install --prefix tests",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "test": "npm test --prefix tests",
    "test:ui": "npm run test:ui --prefix tests"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
